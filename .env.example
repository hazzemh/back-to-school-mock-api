APP_NAME=Back to School Mock Integration API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Live mock snapshots. Same response is returned inside one refresh bucket.
MOCK_DATA_REFRESH_SECONDS=60
# source | normal | warning | critical
MOCK_SCENARIO=source

MOCK_USER_ID=USR-001

# AI adapter: runnable out-of-the-box in mock mode.
MOCK_AI_ENABLED=true
AI_SERVICE_URL=http://ai-service:8080
AI_CHAT_PATH=/chat
AI_TIMEOUT_SECONDS=30

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
